# 복사해서 .env 로 저장 후 값 입력 (.env 는 git 제외). 웹(web/) 개발에는 필요 없음.
DATA_GO_KR_KEY=
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# HyperCLOVA X(CLOVA Studio)로 바꿀 때만 4줄을 채운다. LLM_* 가 있으면 GROQ_* 보다 우선
# LLM_API_URL=https://clovastudio.stream.ntruss.com/v1/openai/chat/completions
# LLM_API_KEY=
# LLM_MODEL=HCX-005
# LLM_REASONING_EFFORT=

# 주소 직접 입력 확인·좌표 변환(네이버 Maps Geocoding API)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 선택: 상가정보에 별도 키를 발급받은 경우 지정. 비우면 DATA_GO_KR_KEY 사용
SBIZ_API_KEY=
