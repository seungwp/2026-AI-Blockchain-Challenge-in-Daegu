# 복사해서 .env 로 저장 후 값 입력 (.env 는 git 제외). 웹(web/) 개발에는 필요 없음.
DATA_GO_KR_KEY=
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 주소 직접 입력 확인(도로명주소 검색 API)
JUSO_SEARCH_API_KEY=
# 좌표제공 API 승인 후 연결 예정
JUSO_COORD_API_KEY=
# 선택: 상가정보에 별도 키를 발급받은 경우 지정. 비우면 DATA_GO_KR_KEY 사용
SBIZ_API_KEY=
